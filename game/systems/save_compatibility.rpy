        $ pennyquestlog = legacy_quest_hint_text["pennyquestlog"].get(pennyquestlog, pennyquestlog)
        $ quest_hint_version = 3
        $ renpy.block_rollback()

    call update_olivia_tournament_hint
    return

label update_olivia_tournament_hint:
    if oliviaphase2interaction2 == 2:
        if dayNumber >= oliviatournyday + 2:
            $ oliviaquestlog = "Visit Olivia at the arcade at Night for the tournament."
        elif dayNumber == oliviatournyday + 1:
            $ oliviaquestlog = "Wait one more night, then visit Olivia at the arcade at Night for the tournament."
        else:
